# App connects as aba_app (cannot bypass RLS). Migrations use the owner role.
DATABASE_URL="postgresql://aba_app:aba_app_dev@localhost:5432/aba"
DIRECT_DATABASE_URL="postgresql://aba_owner:aba_owner_dev@localhost:5432/aba"
TEST_DATABASE_URL="postgresql://aba_app:aba_app_dev@localhost:5432/aba_test"
TEST_DIRECT_DATABASE_URL="postgresql://aba_owner:aba_owner_dev@localhost:5432/aba_test"

# LLM_PROVIDER: anthropic | bedrock | mock
LLM_PROVIDER="mock"
LLM_MODEL="claude-opus-5-5"
ANTHROPIC_API_KEY=""

# Session cookie signing/hash pepper (any long random string for local dev).
SESSION_SECRET="change-me-local-dev-only"

# Sign-in hardening (defaults shown; see src/lib/env.ts).
# SESSION_HOURS=12            # absolute session lifetime, at most 12
# SESSION_IDLE_MINUTES=30     # signed out after this long without activity, at most 30
# AUTH_MAX_FAILED_ATTEMPTS=5  # wrong passwords or codes in a row before the account locks
# AUTH_LOCKOUT_MINUTES=15
# AUTH_RATE_LIMIT_MAX=20      # sign-in requests per client IP per window
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# TRUSTED_PROXY_COUNT=1       # proxies that append to X-Forwarded-For (0 = ignore the header)
