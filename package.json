{
  "name": "aba-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "bash scripts/db-up.sh",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "bash scripts/db-reset.sh",
    "db:seed": "tsx seed/synthetic/index.ts",
    "totp": "tsx scripts/totp.ts",
    "postinstall": "prisma generate",
    "payors:sync": "tsx scripts/payor-sync.ts",
    "rules:watch": "tsx scripts/rules-watch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "otplib": "12.0.1",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "unpdf": "1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.28",
      "deepmerge-ts": "8.0.2"
    }
  }
}
