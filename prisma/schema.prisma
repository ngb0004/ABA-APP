// ABA Treatment Plan & Reauth Assistant: data model.
//
// Tenancy: every org-scoped table carries org_id and is protected by Postgres
// row-level security (see migrations/*_rls). The only tables without RLS are the
// global identity tables `user` and `auth_session`, which hold no client data.
//
// The app connects as the non-owner role `aba_app` (NOBYPASSRLS); migrations run
// as `aba_owner` through DIRECT_DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  BCBA
  BCaBA
  RBT
  AUTH_COORDINATOR
  PARENT
}

// ---------------------------------------------------------------- tenancy/auth

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Practice-specific details (NPI, tax ID, addresses, form names). Per-org only.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())

  memberships Membership[]
  clients     Client[]

  @@map("org")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String
  totpSecret        String?
  mfaEnabled        Boolean   @default(false)
  /// Consecutive wrong authenticator codes across sessions; locks MFA for a while when too high.
  failedMfaCount    Int       @default(0)
  mfaLockedUntil    DateTime?
  createdAt         DateTime  @default(now())
  /// Yoma staff who curate the payor rule library (verify rules against official documents).
  /// Not an org role: set only by scripts/set-curator.ts. A trigger rejects changes by the app role.
  isPlatformCurator Boolean   @default(false)

  memberships Membership[]
  sessions    AuthSession[]

  @@map("user")
}

model Membership {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  userId String @db.Uuid
  role   Role

  org  Org  @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@map("membership")
}

model AuthSession {
  id                String   @id @default(uuid()) @db.Uuid
  tokenHash         String   @unique
  userId            String   @db.Uuid
  orgId             String?  @map("org_id") @db.Uuid
  role              Role?
  mfaVerified       Boolean  @default(false)
  /// Authenticator secret being set up in this sign-in; moved to the user only on confirmation.
  pendingTotpSecret String?
  failedMfaAttempts Int      @default(0)
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  user User @relation(fields: [userId], references: [id])

  @@map("auth_session")
}

/// Append-only. A trigger rejects UPDATE and DELETE. No PHI in meta: IDs only.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("audit_event")
}

// ---------------------------------------------------------------- clients

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  /// v1.0 accepts synthetic data only. A CHECK constraint enforces true.
  isSynthetic    Boolean  @default(true) @map("is_synthetic")
  firstName      String
  lastName       String
  preferredName  String?
  dob            DateTime @db.Date
  sex            String?
  serviceAddress Json     @default("{}")
  /// [{name, relationship, legalCustody: boolean, canSign: boolean}]
  guardians      Json     @default("[]")
  hasIep         Boolean  @default(false)
  /// Payor event triggers that have occurred, e.g. ["bcba_transfer"].
  events         String[] @default([])
  createdAt      DateTime @default(now())

  org             Org                    @relation(fields: [orgId], references: [id])
  diagnoses       Diagnosis[]
  payors          ClientPayor[]
  authorizations  Authorization[]
  sessions        ServiceSession[]
  intakes         Intake[]
  vbmappImports   VbmappImport[]
  administrations VbmappAdministration[]
  goals           Goal[]
  plans           Plan[]
  letters         PayorLetter[]
  attachments     Attachment[]
  benefitsChecks  BenefitsCheck[]
  assessments     Assessment[]

  @@map("client")
}

model Diagnosis {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  clientId       String    @db.Uuid
  dsm5Code       String
  dsm5Label      String
  icd10Code      String
  isPrimary      Boolean   @default(false)
  severity       String?
  evaluationDate DateTime? @db.Date
  /// Deficit areas the diagnosis documents; goals must link to one of these.
  deficitAreas   String[]

  client Client @relation(fields: [clientId], references: [id])
  goals  Goal[]

  @@map("diagnosis")
}

model ClientPayor {
  id                  String  @id @default(uuid()) @db.Uuid
  orgId               String  @map("org_id") @db.Uuid
  clientId            String  @db.Uuid
  payorId             String  @db.Uuid
  priority            String  @default("primary") // primary | secondary
  memberId            String
  planName            String?
  /// medicaid | medicaid_managed_care | commercial_fully_insured | commercial_self_funded
  /// | commercial_unknown | tricare | unknown. Self-funded (ERISA) plans are exempt from state mandates.
  planType            String  @default("unknown")
  /// USPS code of the state the plan was issued in; null means the client's service state.
  planState           String?
  secondaryDocsSigned Boolean @default(false)

  client         Client          @relation(fields: [clientId], references: [id])
  payor          Payor           @relation(fields: [payorId], references: [id])
  benefitsChecks BenefitsCheck[]

  @@map("client_payor")
}

/// A verification of benefits (VOB): what the payor said about this client's coverage, by portal,
/// phone, or electronic eligibility. Kept as history; the latest one is what the audit looks at.
model BenefitsCheck {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  clientId          String   @db.Uuid
  /// The insurance checked; null once that insurance is removed (the check stays as history).
  clientPayorId     String?  @db.Uuid
  /// The payor checked, kept so the history still says whom it was with.
  payorId           String   @db.Uuid
  checkedOn         DateTime @db.Date
  checkedByUserId   String   @db.Uuid
  /// portal | phone | electronic_eligibility | other
  method            String
  /// The call or portal reference number (synthetic in v1.0).
  referenceNumber   String?
  /// yes | no | unknown
  abaCovered        String   @default("unknown")
  /// yes | no | unknown
  priorAuthRequired String   @default("unknown")
  /// fully_insured | self_funded | unknown. Decides whether state autism mandates apply.
  planFunding       String   @default("unknown")
  ageLimitYears     Int?
  visitOrHourLimits String?
  notes             String?
  createdAt         DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  clientPayor ClientPayor? @relation(fields: [clientPayorId], references: [id], onDelete: SetNull)
  payor       Payor        @relation(fields: [payorId], references: [id])

  @@index([clientId, checkedOn])
  @@map("benefits_check")
}

model Attachment {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  clientId        String    @db.Uuid
  /// diagnostic_evaluation | iep | ifsp | prior_evaluation | payor_form | other
  kind            String
  title           String
  documentDate    DateTime? @db.Date
  caregiverSigned Boolean   @default(false)
  uploadedAt      DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@map("attachment")
}

// ---------------------------------------------------------------- authorizations

model Authorization {
  id                      String   @id @default(uuid()) @db.Uuid
  orgId                   String   @map("org_id") @db.Uuid
  clientId                String   @db.Uuid
  payorId                 String   @db.Uuid
  authNumber              String
  kind                    String   @default("initial") // initial | reauth
  startDate               DateTime @db.Date
  endDate                 DateTime @db.Date
  /// Hours/week the BCBA recommends; compared against intake availability.
  recommendedHoursPerWeek Float?

  client   Client              @relation(fields: [clientId], references: [id])
  payor    Payor               @relation(fields: [payorId], references: [id])
  units    AuthorizationUnit[]
  sessions ServiceSession[]
  plans    Plan[]

  @@map("authorization")
}

model AuthorizationUnit {
  id              String @id @default(uuid()) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  authorizationId String @db.Uuid
  cptCode         String
  approvedUnits   Int
  /// week | month | auth
  unitBasis       String

  authorization Authorization @relation(fields: [authorizationId], references: [id])

  @@map("authorization_unit")
}

/// A delivered, billable service. Units are 15-minute CPT units.
model ServiceSession {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  clientId           String   @db.Uuid
  authorizationId    String?  @db.Uuid
  cptCode            String
  date               DateTime @db.Date
  startMinute        Int      @default(540) // minutes after midnight
  units              Int
  providerRole       Role
  /// Opaque staff identifier (e.g. "RBT-A"), used for per-technician supervision ratios.
  providerId         String?
  providerCredential String?
  inPerson           Boolean  @default(true)

  client        Client         @relation(fields: [clientId], references: [id])
  authorization Authorization? @relation(fields: [authorizationId], references: [id])

  @@index([clientId, date])
  @@map("service_session")
}

// ---------------------------------------------------------------- intake

model Intake {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  clientId    String    @db.Uuid
  answers     Json      @default("{}")
  status      String    @default("draft") // draft | submitted
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@map("intake")
}

// ---------------------------------------------------------------- VB-MAPP

model VbmappImport {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  clientId    String    @db.Uuid
  filename    String
  fileSha256  String
  /// Parsed administrations + flags. PHI header cells are never stored.
  parsed      Json
  status      String    @default("pending") // pending | confirmed | discarded
  phiDetected Boolean   @default(false)
  phiStripped Boolean   @default(false)
  reviewerId  String?   @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  client          Client                 @relation(fields: [clientId], references: [id])
  administrations VbmappAdministration[]

  @@map("vbmapp_import")
}

model VbmappAdministration {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  clientId       String    @db.Uuid
  importId       String?   @db.Uuid
  adminNumber    Int
  testDate       DateTime? @db.Date
  testerInitials String?
  /// Recomputed from the raw grid. Workbook totals are never used.
  totals         Json
  flags          Json      @default("[]")
  verified       Boolean   @default(false)
  reviewerId     String?   @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  client Client           @relation(fields: [clientId], references: [id])
  import VbmappImport?    @relation(fields: [importId], references: [id])
  scores MilestoneScore[]

  @@map("vbmapp_administration")
}

model MilestoneScore {
  id               String  @id @default(uuid()) @db.Uuid
  orgId            String  @map("org_id") @db.Uuid
  administrationId String  @db.Uuid
  level            Int
  domain           String
  milestone        Int
  score            Float
  /// The administration in which this score was first observed.
  firstAdmin       Int
  carriedForward   Boolean @default(false)

  administration VbmappAdministration @relation(fields: [administrationId], references: [id])

  @@map("milestone_score")
}

// ---------------------------------------------------------------- assessments

/// One administration of an assessment from the catalog (seed/assessments.yaml), any type.
/// VB-MAPP keeps its own tables (VbmappAdministration) and joins this list through an adapter.
/// Rule 9: scores and names only; no item wording or report text.
model Assessment {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  clientId       String    @db.Uuid
  /// Catalog key, e.g. "vineland_3" or "other".
  typeKey        String
  /// AFLS-style module key from the catalog.
  module         String?
  /// Form key from the catalog (e.g. "parent" for the PDDBI parent form).
  form           String?
  /// Who answered: parent_caregiver | teacher | self | clinician | other.
  respondent     String?
  /// The BCBA's name for an "other" assessment (never a person's name).
  customName     String?
  administeredOn DateTime  @db.Date
  /// Initials or staff code of whoever administered it (no names).
  administeredBy String
  /// manual | import | vbmapp_import
  source         String    @default("manual")
  /// The import it came from (stage 2: report imports).
  importId       String?   @db.Uuid
  /// draft | confirmed. Confirmed by a BCBA (reviewer and time recorded); confirmed rows are locked.
  status         String    @default("draft")
  reviewerId     String?   @db.Uuid
  reviewedAt     DateTime?
  notes          String?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client            @relation(fields: [clientId], references: [id])
  scores AssessmentScore[]

  @@index([clientId, administeredOn])
  @@map("assessment")
}

model AssessmentScore {
  id           String  @id @default(uuid()) @db.Uuid
  orgId        String  @map("org_id") @db.Uuid
  assessmentId String  @db.Uuid
  /// Catalog scale key, or "custom_<slug>" for a scale the BCBA added.
  scaleKey     String
  /// Name and kind of an added (custom) scale; catalog scales take both from the catalog.
  scaleName    String?
  scaleKind    String?
  value        Float
  /// For score-of-possible scales.
  possible     Float?
  /// Where an imported score was read: {file, location, matchedLabel}. Never free text from a report.
  provenance   Json?

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, scaleKey])
  @@map("assessment_score")
}

// ---------------------------------------------------------------- payors

model Payor {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  key            String
  name           String
  inherits       String?
  /// USPS codes the payor's rules apply in; empty means every state (TRICARE, national policies).
  states         String[] @default([])
  /// medicaid | medicaid_managed_care | commercial | tricare | other
  lineOfBusiness String   @default("other")

  rules          PayorRule[]
  clientPayors   ClientPayor[]
  authorizations Authorization[]
  benefitsChecks BenefitsCheck[]

  @@unique([orgId, key])
  @@map("payor")
}

model PayorDocument {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  key           String
  name          String
  /// The version our rules were written against.
  version       String
  effectiveDate DateTime? @db.Date
  url           String?
  /// How to find the current version: {kind: "direct", url} or
  /// {kind: "ga_mmis_index", indexUrl, title}. Null for secondary sources with nothing to watch.
  locator       Json?
  /// Secondary sources (e.g., a practice checklist) can never verify a rule.
  secondary     Boolean   @default(false)
  /// unknown | ok | changed | broken
  health        String    @default("unknown")
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  /// Short, non-sensitive reason for the last failure (HTTP status, "empty response"...).
  lastError     String?

  rules     PayorRule[]
  snapshots PayorDocumentSnapshot[]

  @@unique([orgId, key])
  @@map("payor_document")
}

/// One fetched version of a payor document. Public documents only; text is kept
/// internally for change detection and quote checks, never shown in full.
model PayorDocumentSnapshot {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  documentId    String    @db.Uuid
  fetchedAt     DateTime  @default(now())
  resolvedUrl   String
  contentType   String
  byteLength    Int
  textSha256    String
  text          String
  /// Version label the payor shows (e.g., an effective date or "Last Review" date).
  versionLabel  String?
  effectiveDate DateTime? @db.Date
  /// When the payor says the next revision is due, if it publishes that.
  nextRevision  DateTime? @db.Date
  /// Change-log rows the payor publishes: [{date, section, description, change}]
  revisions     Json      @default("[]")
  /// fetch (the watcher downloaded it) | upload (a BCBA uploaded the official file)
  origin        String    @default("fetch")
  uploadedById  String?   @db.Uuid

  document PayorDocument @relation(fields: [documentId], references: [id])

  @@index([documentId, fetchedAt])
  @@map("payor_document_snapshot")
}

model PayorRule {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  payorId          String   @db.Uuid
  type             String
  params           Json
  sourceDocumentId String?  @db.Uuid
  sourceSection    String?
  /// Page in the official document where the rule was read.
  sourcePage       String?
  /// The official sentence the rule was read from (pre-fills verification; never trusted on its own).
  sourceQuote      String?
  notes            String?
  /// Payor key this rule was inherited from (e.g., ga_medicaid for Amerigroup).
  inheritedFrom    String?
  /// Shared by a rule and the copies other payors inherit, so evidence applies to all of them.
  lineageKey       String
  /// Plan types the rule is limited to; empty means every plan type.
  planTypes        String[] @default([])
  ordinal          Int      @default(0)

  payor          Payor          @relation(fields: [payorId], references: [id])
  sourceDocument PayorDocument? @relation(fields: [sourceDocumentId], references: [id])

  @@index([orgId, lineageKey])
  @@map("payor_rule")
}

/// Append-only evidence for a rule lineage. A rule's status is computed from
/// this, never typed in. Revocations are new rows, not edits.
model RuleEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  lineageKey String
  /// verify | revoke
  kind       String
  /// T1 official document, T2 written payor correspondence, T3 portal chat,
  /// T4 phone with reference number, T5 secondary source
  tier       String
  /// document | letter | portal | phone | secondary
  channel    String
  documentId String?  @db.Uuid
  snapshotId String?  @db.Uuid
  section    String?
  quote      String   @default("")
  textSha256 String?
  reference  String?
  reviewerId String?  @db.Uuid
  note       String?
  createdAt  DateTime @default(now())

  @@index([orgId, lineageKey, createdAt])
  @@map("rule_evidence")
}

/// A problem with a library rule, reported by someone in the practice ("doesn't match my
/// denial letter"). Yoma's curators review open reports; the rule itself is never changed here.
model RuleReport {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  lineageKey   String
  /// The rule row the report was made from (for display; the lineage is what curators fix).
  ruleId       String?   @db.Uuid
  /// doesnt_match_letter | outdated | wrong_for_state_plan | other
  reason       String
  note         String    @default("")
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  resolution   String?

  @@index([orgId, resolvedAt, createdAt])
  @@map("rule_report")
}

// ---------------------------------------------------------------- goals

model GoalTemplate {
  id               String @id @default(uuid()) @db.Uuid
  orgId            String @map("org_id") @db.Uuid
  domainNumber     Int
  domainName       String
  tier             Int
  tierName         String
  category         String
  goalText         String
  rationalePattern String
  rationaleText    String
  /// [{level, domain, from, to}] VB-MAPP milestones this template addresses.
  linkedMilestones Json   @default("[]")

  @@unique([orgId, domainNumber, tier])
  @@map("goal_template")
}

model Goal {
  id                         String    @id @default(uuid()) @db.Uuid
  orgId                      String    @map("org_id") @db.Uuid
  clientId                   String    @db.Uuid
  planId                     String?   @db.Uuid
  templateId                 String?   @db.Uuid
  diagnosisId                String?   @db.Uuid
  ordinal                    Int       @default(0)
  domain                     String
  tier                       Int
  /// communication | social_play | behavior_reduction | replacement | caregiver | other
  category                   String
  deficitArea                String?
  /// percent | frequency | duration. Frequency/duration goals improve downward.
  measure                    String    @default("percent")
  linkedMilestones           Json      @default("[]")
  initiationWindow           String    @default("Months 1-3")
  objective                  String
  sd                         String    @default("")
  targetBehavior             String    @default("")
  dataCollection             String    @default("")
  prompting                  String    @default("")
  teachingProcedure          String    @default("")
  phases                     Json      @default("[]")
  masteryAccuracyPct         Int       @default(80)
  masteryConsecutiveSessions Int       @default(5)
  masteryInstructors         Int       @default(2)
  masterySettings            Int       @default(1)
  generalization             String    @default("")
  rationalePattern           String    @default("A")
  rationale                  String    @default("")
  /// Pointer to the sourced baseline: {kind: "datapoints", window} or {kind: "vbmapp", ...}
  baselineSource             Json?
  replacementForGoalId       String?   @db.Uuid
  status                     String    @default("draft") // draft | approved
  /// Required before export when progress is flat over 8+ weeks.
  flatExplanation            String?
  /// When the goal was first taught.
  introducedAt               DateTime? @db.Date
  projectedMasteryDate       DateTime? @db.Date
  /// new | in_progress | mastered | on_hold | discontinued
  progressStatus             String    @default("in_progress")
  /// Baseline recorded from the goal's own data and locked by the BCBA; never changes once locked.
  baselineValue              Float?
  baselineDate               DateTime? @db.Date
  baselineLockedAt           DateTime?
  baselineLockedById         String?   @db.Uuid
  /// Barriers to progress on this goal and what was done about them.
  barriers                   String    @default("")
  /// Settings the goal is taught in, e.g. ["home", "clinic"].
  settings                   Json      @default("[]")
  approvedById               String?   @db.Uuid
  approvedAt                 DateTime?

  client       Client            @relation(fields: [clientId], references: [id])
  plan         Plan?             @relation(fields: [planId], references: [id])
  diagnosis    Diagnosis?        @relation(fields: [diagnosisId], references: [id])
  dataPoints   GoalDataPoint[]
  phaseChanges GoalPhaseChange[]

  @@map("goal")
}

model GoalDataPoint {
  id     String   @id @default(uuid()) @db.Uuid
  orgId  String   @map("org_id") @db.Uuid
  goalId String   @db.Uuid
  date   DateTime @db.Date
  /// Percent correct (0-100) unless the goal measures frequency/duration.
  value  Float
  trials Int?

  goal Goal @relation(fields: [goalId], references: [id])

  @@index([goalId, date])
  @@map("goal_data_point")
}

model GoalPhaseChange {
  id     String   @id @default(uuid()) @db.Uuid
  orgId  String   @map("org_id") @db.Uuid
  goalId String   @db.Uuid
  date   DateTime @db.Date
  label  String

  goal Goal @relation(fields: [goalId], references: [id])

  @@map("goal_phase_change")
}

// ---------------------------------------------------------------- plans

model Plan {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  clientId         String    @db.Uuid
  authorizationId  String?   @db.Uuid
  type             String // initial | reauth
  status           String    @default("draft") // draft | finalized
  /// [{key, name, version}] payor documents this plan was written against.
  payorDocVersions Json      @default("[]")
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  finalizedAt      DateTime?

  client        Client         @relation(fields: [clientId], references: [id])
  authorization Authorization? @relation(fields: [authorizationId], references: [id])
  sections      PlanSection[]
  goals         Goal[]
  packet        Packet?

  @@map("plan")
}

model PlanSection {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  planId       String    @db.Uuid
  key          String
  ordinal      Int
  title        String
  state        String    @default("draft") // draft | edited | approved
  /// Last AI draft (tokenized, firewall-validated).
  aiDraft      String?
  /// Current content (tokenized). Rendered by substituting sourced values.
  content      String    @default("")
  /// {itemKey: {status: "answered"|"none", note?}}
  items        Json      @default("{}")
  approvedById String?   @db.Uuid
  approvedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  plan      Plan                  @relation(fields: [planId], references: [id])
  revisions PlanSectionRevision[]

  @@unique([planId, key])
  @@map("plan_section")
}

model PlanSectionRevision {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  sectionId String   @db.Uuid
  kind      String // ai_draft | edit | approve | reopen
  content   String
  /// Unified-style line diff against the AI draft.
  diff      String   @default("")
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())

  section PlanSection @relation(fields: [sectionId], references: [id])

  @@map("plan_section_revision")
}

// ---------------------------------------------------------------- letters/packets

model PayorLetter {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  clientId        String    @db.Uuid
  authorizationId String?   @db.Uuid
  filename        String
  text            String
  /// approval | denial | reduction | request_for_info | p2p_offer
  classification  String?
  /// Extracted fields, each with the verbatim quote it came from.
  extracted       Json      @default("{}")
  status          String    @default("pending") // pending | confirmed
  confirmedById   String?   @db.Uuid
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@map("payor_letter")
}

model Packet {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  planId      String    @unique @db.Uuid
  letterId    String?   @db.Uuid
  status      String    @default("draft") // draft | ready | submitted
  checklist   Json      @default("[]")
  pdfSha256   String?
  exportedAt  DateTime?
  submittedAt DateTime?

  plan Plan @relation(fields: [planId], references: [id])

  @@map("packet")
}
